# Leave Buffer settings empty to use the sample workspace.
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
BUFFER_REDIRECT_URI=https://localhost:3000/api/buffer/callback

# Generate a fresh key with node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Supply the key through the server process environment or the host's secret store.
PATCHWORK_TOKEN_KEY=

# Local SQLite defaults to .patchwork/patchwork.sqlite.
# A self-hosted SQLite deployment needs an absolute path on a persistent volume.
PATCHWORK_DB_PATH=

# Vercel production uses a pooled Postgres connection instead of SQLite.
DATABASE_URL=

# Required for a public OAuth callback. Use the IDs returned by Buffer for the
# one operator and organization allowed to connect to this deployment.
PATCHWORK_BUFFER_ACCOUNT_ID=
PATCHWORK_BUFFER_ORGANIZATION_ID=
